{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "opener:default",
    "allow-ping",
    "allow-ping-fail",
    "allow-report-status",
    "allow-open-pdf",
    "allow-open-pdf-path",
    "allow-render-page",
    "allow-extract-text-in-bbox",
    "allow-save-detection-categories",
    "allow-load-detection-categories",
    "allow-get-bookmarks",
    "allow-save-sidecar",
    "allow-load-sidecar",
    "allow-detect-review-items",
    "allow-cancel-detection",
    "allow-save-color-settings",
    "allow-load-color-settings",
    "allow-save-global-color-settings",
    "allow-load-global-color-settings",
    "allow-export-review-items",
    "allow-import-review-items",
    "allow-reanchor-review-item-bboxes",
    "allow-save-redacted-document",
    "allow-cancel-operation",
    "allow-open-path-external"
  ]
}
